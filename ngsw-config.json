{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/*.png"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalog",
      "urls": ["/api/caregivers/search"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "10m",
        "timeout": "10s"
      }
    },
    {
      "name": "user-data",
      "urls": [
        "/api/profiles/me",
        "/api/shifts/me",
        "/api/bookings",
        "/api/visits/me",
        "/api/me/notifications"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "1h",
        "timeout": "10s"
      }
    }
  ]
}